{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/loadguard-build",
            "args": ["${CLAUDE_PLUGIN_DATA}"],
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/loadguard",
            "args": ["${CLAUDE_PLUGIN_DATA}"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
